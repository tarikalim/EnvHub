# envhub settings. Copy to ~/.config/envhub/.env — every key is optional, and
# envhub writes this file there itself the first time it runs.

# Folders to search for .env files, separated by ":" like PATH.
# Commented out means your whole home folder.
#ENVHUB_ROOTS=~/code:~/work/backend

# Extra folder names to ignore, anywhere under the roots. node_modules, .git,
# Library, target, .venv and .cache are already ignored.
#ENVHUB_SKIP=dist:backup
